# Matches infra/docker-compose.dev.yml (Postgres 5433, Redis 6380).
PORT=8383
# Unset: loopback (127.0.0.1) in production, every interface in dev.
HOST=
NODE_ENV=development
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=zuuchmap
PG_PASSWORD=zuuchmap
PG_DATABASE=zuuchmap
PG_SSL=false
# Optional: unset => in-memory fallback (single instance only). Required in production.
REDIS_URL=redis://127.0.0.1:6380
# At least 32 characters.
JWT_SECRET=change-me-change-me-change-me-change-me
# Comma-separated; list every host (a bare apex does not cover www.).
ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8383/api
PUBLIC_WEB_URL=http://localhost:5173
# Optional: unset => no error reporting.
SENTRY_DSN=
# Comma-separated 8-digit phone numbers that are admins (clients read is_admin from the auth response).
ADMIN_PHONES=
# verify.mn (sign-in by text to 144773, 150 MNT per verification). Unset API key => inert:
# outside production a fake mode auto-verifies on the first poll; in production start answers 503.
VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn
VERIFY_MN_TIMEOUT_MS=10000
# Verification session lifetime (ms), default 5 minutes.
VERIFY_TTL_MS=300000
# Max paid verifications per phone per RATE_TTL_MS window (default 5 per hour).
VERIFY_RATE_LIMIT=5
RATE_TTL_MS=3600000
# Optional: "false" skips inserting missing seed categories at boot (default true; never overwrites edits).
CATEGORY_SEED_ON_BOOT=true
# Listings. Salt for hashed viewer keys (default: JWT_SECRET; set it to the old secret before rotating).
VIEW_KEY_SALT=
# Fresh anonymous viewers one address may add to one listing per day (default 30).
VIEW_ANON_PER_IP_PER_DAY=30
# Live-listing quota per plan (defaults 3 / 25).
POST_QUOTA_FREE=3
POST_QUOTA_PROVIDER=25
# Listing window in days: default and paid-plan (a category's post_expiry_days wins).
POST_EXPIRY_DAYS=30
POST_PROVIDER_EXPIRY_DAYS=90
# Approved listings (and no rejection) after which a provider's edits publish without review.
POST_PROVEN_APPROVED=3
# Photos on Cloudflare R2. Leave all unset => photo upload answers 503; set all five or boot fails.
# R2_ENDPOINT overrides the endpoint derived from the account id.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Notifications (phase 7). Each transport is off while its variables are unset.
# Web push: generate a pair with `npx web-push generate-vapid-keys`; subject is mailto: or https:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# E-mail goes only to accounts with no push device. SMTP_SECURE defaults to true on port 465.
# Dev: `docker compose -f infra/docker-compose.dev.yml up -d mailpit` → SMTP_HOST=localhost SMTP_PORT=1025, inbox on :8025.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Only when the Expo project enforces push security.
EXPO_ACCESS_TOKEN=
# Stored notifications older than this many days are deleted nightly (default 90).
NOTIFICATION_RETENTION_DAYS=90
