# Zuuchmap engine — every environment variable the code reads.
#
# This is a TEMPLATE, not a live config. The real file is
# `config/variables/<NODE_ENV>.env` (development.env | production.env), which is
# gitignored and lives on the server. Copy this there and fill it in.
#
# It exists because the deployed env file drifted behind the code: features
# shipped over several releases (payments, web push, email, error reporting)
# read variables that no file in the repo ever named, so each one was silently
# inert in production with nothing to notice. Anything the engine reads belongs
# here, with the consequence of leaving it unset written next to it.
#
# NEVER put real secrets in this file. Placeholders only.

# ── Required ─────────────────────────────────────────────────────────────────
# The engine will not serve correctly without these.

PROG_PORT=8282
JWT_SECRET=change-me-to-a-long-random-string

PG_HOST=localhost
PG_PORT=5432
PG_USER=zuuchmap
PG_PWD=change-me
PG_NAME=zuuchmap

# Comma-separated phone numbers that get admin rights. Read by admin.guard.ts;
# the clients never duplicate this list, they read `is_admin` off the JWT.
ADMIN_PHONES=99119911,88118811

# Comma-separated browser origins. Gates BOTH the HTTP CORS allowlist (main.ts)
# and the Socket.io one (events.gateway.ts). A request with no Origin — the app,
# curl, verify.mn's callback — is never affected. List every host the web app is
# served from: a bare apex here blocks www.
ALLOWED_ORIGIN=https://zuuchmap.com,https://www.zuuchmap.com

# Where verify.mn sends its callback. Verification silently fails without it.
PUBLIC_ENGINE_URL=https://zuuchmap.com/engine

# ── Uploads (Cloudflare R2, S3-compatible) ───────────────────────────────────
# Unset ⇒ every image upload fails.

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zuuchmap
R2_PUBLIC_URL=https://cdn.zuuchmap.com

# ── Phone verification (verify.mn, Mobile-Originated) ────────────────────────
# We never send an SMS: the user texts a code to shortcode 144773 and possession
# is proven by the message arriving from that number. Costs the END USER 150₮
# per verification, which is why VERIFY_RATE_LIMIT exists and why a trusted
# device short-circuits to a token.

VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn
VERIFY_MN_TIMEOUT_MS=10000
# How long one verification session stays open.
VERIFY_TTL_MS=300000
# Paid verifications allowed per phone per RATE_TTL_MS.
VERIFY_RATE_LIMIT=5
RATE_TTL_MS=3600000
# Retired name for VERIFY_RATE_LIMIT, still read as a fallback. Prefer the above.
# OTP_RATE_LIMIT=5

# ── Rate limiting ────────────────────────────────────────────────────────────
# Global per-IP default. Routes needing to be stingier set their own @Throttle:
# auth/verify/start and the legacy user/check are 3/min regardless.
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# ── Housekeeping ─────────────────────────────────────────────────────────────
# Analytics rows older than this are pruned nightly by AnalyticsService.
ANALYTICS_RETENTION_DAYS=90

# Origin the sitemap and OG tags are built from.
PUBLIC_WEB_URL=https://zuuchmap.com

# ── Optional: multi-instance (Redis) ─────────────────────────────────────────
# UNSET ⇒ SINGLE INSTANCE ONLY. Without Redis each pm2 worker keeps its own
# rate-limit counters, cache and socket broadcasts, so a second worker splits
# all three. Set this before raising PM2_INSTANCES, never after.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Optional: error reporting ────────────────────────────────────────────────
# Unset ⇒ no-op. Unhandled 5xx, uncaught exceptions and rejected promises stay
# in the pm2 log and nowhere else.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Optional: payments (QPay) ────────────────────────────────────────────────
# Unset ⇒ qpayConfigured() is false and /payments/invoice answers 503 rather
# than half-working.
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
# QPAY_BASE_URL=https://merchant.qpay.mn/v2
# QPAY_TIMEOUT_MS=15000

# Monthly price of the PROVIDER plan, in tugrik.
# ⚠ THE BUILT-IN DEFAULT (49900) IS A PLACEHOLDER NOBODY CHOSE. Set the real
# number before QPay credentials go in, or the first invoice charges it.
# PLAN_PRICE_PROVIDER_MNT=49900

# Price of ONE DAY of featured placement on one listing, in tugrik.
# Sold per post per day, separately from the plan ladder — placement buys
# attention on a listing, not entitlement on an account, so a FREE provider can
# buy it too. Deliberately has NO built-in default: unset ⇒ the catalogue
# reports featured.enabled=false and /payments/invoice answers 503, which is a
# state someone notices. That is the opposite of the line above, on purpose.
# FEATURED_PRICE_PER_DAY_MNT=2000

# ── Optional: browser push (VAPID) ───────────────────────────────────────────
# Unset ⇒ web push is silently skipped; app push and email are unaffected.
# Generate the pair once with `npx web-push generate-vapid-keys`. The public
# half is served by GET /user/push/vapid-key so the two sides cannot drift.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@zuuchmap.com

# ── Optional: email ──────────────────────────────────────────────────────────
# Only ever a payment receipt, or a fallback for an account with NO push device
# at all. Signup is phone-based, so most accounts have no address and get
# nothing here. Unset ⇒ mailer is a no-op.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Zuuchmap <no-reply@zuuchmap.com>
