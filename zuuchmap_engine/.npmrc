# typeorm@0.3.x declares `peerOptional ioredis@^5`, and this project runs
# ioredis@6 — which TypeORM never touches, since Redis reaches the app through
# utils/redis.ts, not TypeORM's cache. Without this, every `npm install` fails
# with ERESOLVE: local setup, CI, and deploy.sh's install step on the VPS.
legacy-peer-deps=true
