# Zuuchmap web — every environment variable the app reads.
#
# Copy to `.env` (or `.env.local`) and fill in. Vite only exposes variables
# prefixed VITE_ to client code, and everything here ends up in the built
# bundle — so none of these may be a secret.
#
# All are optional: each has a working default for local development.

# API origin. Defaults to the dev proxy locally and the production engine in a
# release build; set it to point a local web app at a LAN or staging engine.
# VITE_API_URL=http://localhost:8282/engine

# Socket.io origin for realtime (hooks/useRealtimeSync.js). Defaults to the API
# origin above — set it only when the gateway is served from somewhere else.
# VITE_EVENTS_URL=http://localhost:8282

# Leaflet tile provider: osm | stadia. Default is osm — OpenStreetMap's own
# tiles, inverted by CSS for the dark theme. CARTO, the old default, now stamps
# every free tile "API KEY REQUIRED" and was dropped (2026-09).
#
# Stadia draws Ulaanbaatar in more detail, but it answers 401 to any origin not
# registered in its dashboard — which is how every tile on the deployed site
# came back grey. Opt in only once zuuchmap.com is listed there.
# VITE_MAP_TILES=osm

# Error reporting. Unset ⇒ no-op, and errors stay in the browser console.
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=
